# TRADING HQ — environment template. Copy to .env.local and fill in. NEVER commit .env.local.

# --- Required (Phase 1) -------------------------------------------------------
# Supabase → Project Settings → API (or "Connect" → App Frameworks)
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
# Publishable key (sb_publishable_...) — or the legacy anon key via NEXT_PUBLIC_SUPABASE_ANON_KEY.
# Safe in the browser: every table is protected by Row Level Security.
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=your-publishable-key

# --- Server-only (do NOT prefix with NEXT_PUBLIC_) ---------------------------
# Phase 3 — AI assistant
# OpenAI key from platform.openai.com → API keys. Server-only. Spend is capped per month in Settings → AI.
OPENAI_API_KEY=
# Phase 4 — integrations (only after verifying API access)
# SUPABASE_SECRET_KEY=
# TRADOVATE_CLIENT_ID=
# TRADOVATE_CLIENT_SECRET=
# TRADINGVIEW_WEBHOOK_SECRET=
